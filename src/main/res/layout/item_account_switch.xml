<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      One row of the account switcher. Doubles as the "All accounts" row, where the avatar slot
      carries a generic icon instead of a contact photo and the subtitle counts unread chats.

      Height is a 56dp minimum rather than a fixed value so the row grows with the user's font
      scale instead of clipping the second line.
    -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?selectableItemBackground"
        android:minHeight="56dp"
        android:paddingHorizontal="24dp"
        android:paddingVertical="10dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/account_image"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/account_image_description"
            android:scaleType="centerCrop"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Circular" />

        <TextView
            android:id="@+id/account_jid"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="12dp"
            android:ellipsize="middle"
            android:maxLines="1"
            android:textAppearance="?textAppearanceBodyLarge"
            android:textColor="?colorOnSurface"
            app:layout_constraintBottom_toTopOf="@+id/account_status"
            app:layout_constraintEnd_toStartOf="@+id/account_selected"
            app:layout_constraintStart_toEndOf="@+id/account_image"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            tools:text="juliet@example.com" />

        <TextView
            android:id="@+id/account_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="12dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?textAppearanceBodySmall"
            android:textColor="?colorOnSurfaceVariant"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/account_selected"
            app:layout_constraintStart_toEndOf="@+id/account_image"
            app:layout_constraintTop_toBottomOf="@+id/account_jid"
            tools:text="Online" />

        <!-- A check rather than a radio: this is a committed choice, not a pending form value. -->
        <ImageView
            android:id="@+id/account_selected"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_done_24dp"
            android:visibility="invisible"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="?colorPrimary"
            tools:visibility="visible" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
