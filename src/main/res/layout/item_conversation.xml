<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Two stacked FrameLayouts are load-bearing, not decoration: the outer one is the colour the
      swipe gesture reveals, and @id/frame is the layer ItemTouchHelper translates and that the
      adapter recolours for the selected row on tablets.

      Inside, one ConstraintLayout positions the avatar, two text lines and the two trailing
      clusters. The clusters are horizontal LinearLayouts rather than further constraints on purpose:
      almost every glyph in them is conditionally GONE, and a LinearLayout drops a GONE child's
      margins along with the child. Expressing the same thing with chained constraints and
      goneMargins cannot distinguish "no sender name" from "no attachment icon" from neither, and
      gets the indent wrong in the mixed cases.
    -->
    <FrameLayout
        android:background="?colorSecondaryFixedDim"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:descendantFocusability="blocksDescendants">

        <FrameLayout
            android:background="?colorSurface"
            android:id="@+id/frame"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:selectableItemBackground"
                android:minHeight="@dimen/conversation_row_height"
                android:paddingHorizontal="@dimen/conversation_row_horizontal_padding"
                android:paddingVertical="8dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/conversation_image"
                    android:layout_width="@dimen/conversation_avatar_size"
                    android:layout_height="@dimen/conversation_avatar_size"
                    android:scaleType="centerCrop"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Circular" />

                <!-- Line one: name, then pin / mute / timestamp -->

                <LinearLayout
                    android:id="@+id/conversation_meta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    app:layout_constraintBottom_toBottomOf="@+id/conversation_name"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/conversation_name">

                    <ImageView
                        android:id="@+id/pinned_on_top"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginEnd="4dp"
                        android:contentDescription="@string/add_to_favorites"
                        android:src="@drawable/ic_star_24dp"
                        app:tint="?colorOnSurfaceVariant"
                        tools:visibility="visible" />

                    <ImageView
                        android:id="@+id/notification_status"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginEnd="6dp"
                        android:src="@drawable/ic_notifications_off_24dp"
                        app:tint="?colorOnSurfaceVariant"
                        tools:visibility="visible" />

                    <TextView
                        android:id="@+id/conversation_lastupdate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:textAppearance="?textAppearanceBodySmall"
                        android:textColor="?colorOnSurfaceVariant"
                        tools:text="23:42" />
                </LinearLayout>

                <TextView
                    android:id="@+id/conversation_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/avatar_item_distance"
                    android:layout_marginEnd="8dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="?textAppearanceTitleMedium"
                    android:textColor="?colorOnSurface"
                    app:layout_constraintBottom_toTopOf="@+id/conversation_preview"
                    app:layout_constraintEnd_toStartOf="@+id/conversation_meta"
                    app:layout_constraintStart_toEndOf="@+id/conversation_image"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_chainStyle="packed"
                    tools:text="Juliet Capulet" />

                <!-- Line two: sender, attachment glyph and preview, then tick / unread badge -->

                <LinearLayout
                    android:id="@+id/conversation_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    app:layout_constraintBottom_toBottomOf="@+id/conversation_preview"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/conversation_preview">

                    <ImageView
                        android:id="@+id/message_status"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_done_all_24dp"
                        app:tint="?colorPrimary" />

                    <eu.siacs.conversations.ui.widget.UnreadCountCustomView
                        android:id="@+id/unread_count"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/unread_badge_size"
                        android:layout_marginStart="4dp"
                        android:minHeight="@dimen/unread_badge_size"
                        android:visibility="gone"
                        app:backgroundColor="?colorPrimary"
                        app:textColor="?colorOnPrimary"
                        tools:visibility="visible" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/conversation_preview"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/avatar_item_distance"
                    android:layout_marginTop="2dp"
                    android:layout_marginEnd="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/conversation_status"
                    app:layout_constraintStart_toEndOf="@+id/conversation_image"
                    app:layout_constraintTop_toBottomOf="@+id/conversation_name">

                    <TextView
                        android:id="@+id/sender_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:maxLines="1"
                        android:text="@string/me"
                        android:textAppearance="?textAppearanceBodyMedium"
                        android:textColor="?colorOnSurfaceVariant" />

                    <ImageView
                        android:id="@+id/conversation_lastmsg_img"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginEnd="4dp"
                        app:tint="?colorOnSurfaceVariant"
                        tools:visibility="visible" />

                    <TextView
                        android:id="@+id/conversation_lastmsg"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textAppearance="?textAppearanceBodyMedium"
                        android:textColor="?colorOnSurfaceVariant"
                        tools:text="Hi. What’s up?" />
                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </FrameLayout>
    </FrameLayout>
</layout>
