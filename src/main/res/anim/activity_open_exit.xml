<?xml version="1.0" encoding="utf-8"?>
<!-- Forward navigation, outgoing screen. Recedes slightly so the incoming screen reads as on top. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@interpolator/emphasized_accelerate">

    <translate
        android:duration="300"
        android:fromXDelta="0"
        android:toXDelta="-4%p" />

    <alpha
        android:duration="300"
        android:fromAlpha="1.0"
        android:toAlpha="0.0" />
</set>
